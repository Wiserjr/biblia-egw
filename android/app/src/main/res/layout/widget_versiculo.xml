<?xml version="1.0" encoding="utf-8"?>
<!-- Widget do versículo do dia (VersiculoWidget.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_titulo"
        android:textColor="@color/widget_destaque"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_texto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/widget_texto"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/widget_referencia"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="@color/widget_destaque"
        android:textSize="13sp" />
</LinearLayout>
